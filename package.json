{
  "name": "connected-workspace-mcp",
  "version": "1.0.1",
  "type": "module",
  "description": "Stdio MCP server for Gmail, Calendar, Sheets, Drive, Contacts, Tasks, and LinkedIn",
  "author": "Deepak Kamboj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepakkamboj/connected-workspace-mcp.git"
  },
  "homepage": "https://github.com/deepakkamboj/connected-workspace-mcp#readme",
  "bugs": {
    "url": "https://github.com/deepakkamboj/connected-workspace-mcp/issues"
  },
  "main": "dist/src/index.js",
  "bin": {
    "connected-workspace-mcp": "dist/src/index.js",
    "connected-workspace-google-auth": "dist/src/auth/google/authorize.js",
    "connected-workspace-linkedin-auth": "dist/src/auth/linkedin/authorize.js"
  },
  "files": [
    "dist/src/",
    "docs/",
    "examples/",
    ".env.example",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmail",
    "google-calendar",
    "google-sheets",
    "google-drive",
    "google-contacts",
    "google-tasks",
    "linkedin",
    "social-networking",
    "productivity"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run format:check && npm test && npm run check && npm run build",
    "prepublishOnly": "npm run test:package",
    "test": "jest --runInBand",
    "test:auth": "jest --runInBand --runTestsByPath tests/auth.test.ts",
    "test:gmail": "jest --runInBand --runTestsByPath tests/gmail-tools.test.ts",
    "test:calendar": "jest --runInBand --runTestsByPath tests/calendar-tools.test.ts",
    "test:linkedin": "jest --runInBand --runTestsByPath tests/linkedin-tools.test.ts tests/linkedin-client.test.ts",
    "test:coverage": "jest --runInBand --coverage",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "auth": "npm run auth:google",
    "auth:google": "tsx src/auth/google/authorize.ts",
    "auth:linkedin": "tsx src/auth/linkedin/authorize.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "dotenv": "^17.0.0",
    "googleapis": "^160.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
